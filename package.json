{
  "name": "orders-console",
  "version": "0.1.0",
  "private": true,
  "description": "SARH Business Solutions Orders Console - monorepo",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @orders-console/api",
    "dev:web": "npm run dev --workspace @orders-console/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed": "tsx apps/api/src/db/seed.ts",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:push": "drizzle-kit push --config apps/api/drizzle.config.ts",
    "docker:build": "docker compose up --build -d",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.19.2"
  }
}
